rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // HELPER FUNCTIONS
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'admin')
      );
    }

    function isOrganizer() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == 'organizer' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (getUserData().role == 'organizer' ||
          getUserData().isOrganizer == true ||
          getUserData().orgStatus == 'approved' ||
          getUserData().isPowerOrganizer == true))
      );
    }

    // STRICT OWNER OR ADMIN CHECK
    // Explicitly avoids universal isOrganizer() bypasses to prevent cross-organization tampering.
    function isHostOrAdmin(docData) {
      return isAuthenticated() && (
        isAdmin() ||
        (docData.hostUid != null && docData.hostUid == request.auth.uid) ||
        (docData.orgId != null && docData.orgId == request.auth.uid) ||
        (docData.hostId != null && docData.hostId == request.auth.uid) ||
        (docData.userId != null && docData.userId == request.auth.uid) ||
        (docData.organizerId != null && docData.organizerId == request.auth.uid) ||
        (docData.organizationId != null && docData.organizationId == request.auth.uid) ||
        (docData.createdBy != null && docData.createdBy == request.auth.uid)
      );
    }

    // ===============================================================
    // USERS & ORGANIZATIONS
    // ===============================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isUser(userId);
      allow update: if (isUser(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'balance', 'walletBalance', 'bonusBalance', 'reservedBalance',
          'lockedMoney', 'orgWalletBalance', 'escrowBalance', 'role',
          'banned', 'isBanned', 'orgStatus', 'isPowerOrganizer', 'isPowerOrg', 'orgTier'
        ]))
        || isAdmin();
      allow delete: if isAdmin();
    }

    match /users_public/{userId} {
      allow read: if true;
      allow write: if isUser(userId) || isAdmin();
    }

    match /organizations/{orgId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid ||
        request.resource.data.hostUid == request.auth.uid ||
        isUser(orgId) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.hostUid == request.auth.uid ||
        isUser(orgId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ===============================================================
    // TOURNAMENTS & SCRIMS COLLECTIONS
    // ===============================================================
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isOrganizer() || isAdmin();
      // Invariant: Once completed or cancelled, event is archived and cannot be restarted/reopened
      allow update: if (isHostOrAdmin(resource.data) && (
        isAdmin() ||
        !(resource.data.status in ['completed', 'cancelled']) ||
        request.resource.data.status == resource.data.status
      )) || (
        isAuthenticated() && 
        !(resource.data.status in ['completed', 'cancelled']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots', 'filledSlots', 'currentPlayers'])
      );
      allow delete: if isHostOrAdmin(resource.data);

      match /credentials/{credentialId} {
        allow read, write: if isHostOrAdmin(get(/databases/$(database)/documents/tournaments/$(tournamentId)).data);
      }

      match /groups/{groupId} {
        allow read: if true;
        allow write: if isHostOrAdmin(get(/databases/$(database)/documents/tournaments/$(tournamentId)).data);
      }

      match /matches/{matchId} {
        allow read: if true;
        allow write: if isHostOrAdmin(get(/databases/$(database)/documents/tournaments/$(tournamentId)).data);
      }
    }

    match /scrims/{scrimId} {
      allow read: if true;
      allow create: if isOrganizer() || isAdmin();
      // Invariant: Once completed or cancelled, scrim is archived and cannot be restarted/reopened
      allow update: if (isHostOrAdmin(resource.data) && (
        isAdmin() ||
        !(resource.data.status in ['completed', 'cancelled']) ||
        request.resource.data.status == resource.data.status
      )) || (
        isAuthenticated() && 
        !(resource.data.status in ['completed', 'cancelled']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots', 'filledSlots', 'currentPlayers'])
      );
      allow delete: if isHostOrAdmin(resource.data);

      match /credentials/{credentialId} {
        allow read, write: if isHostOrAdmin(get(/databases/$(database)/documents/scrims/$(scrimId)).data);
      }
    }

    // ===============================================================
    // PARTICIPANTS (REGISTRATIONS & SLOTS)
    // ===============================================================
    match /participants/{participantId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isOrganizer() ||
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.hostUid == request.auth.uid ||
        resource.data.orgId == request.auth.uid ||
        isAdmin()
      );
    }

    // ===============================================================
    // TEAMS & ROSTERS
    // ===============================================================
    match /teams/{teamId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.captainId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
    }

    match /team_members/{memberId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    match /team_invites/{inviteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.inviteeId == request.auth.uid ||
        resource.data.inviterId == request.auth.uid ||
        isAdmin()
      );
    }

    match /team_activity/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // NOTIFICATIONS
    // ===============================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // ===============================================================
    // WALLET & TRANSACTIONS
    // ===============================================================
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.orgId != null && resource.data.orgId == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isOrganizer() ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // PENDING REFUNDS QUEUE
    // ===============================================================
    match /pending_refunds/{refundId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.hostUid != null && resource.data.hostUid == request.auth.uid) ||
        (resource.data.releasedBy != null && resource.data.releasedBy == request.auth.uid) ||
        (resource.data.orgId != null && resource.data.orgId == request.auth.uid) ||
        isAdmin()
      );
      // Admin or an authentic host releasing another player's slot can create
      allow create: if isAuthenticated() && (
        isAdmin() ||
        ((request.resource.data.hostUid == request.auth.uid || request.resource.data.releasedBy == request.auth.uid) &&
         request.resource.data.userId != request.auth.uid &&
         request.resource.data.amount > 0)
      );
      // Admin or the refund recipient marking their refund as completed
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && request.resource.data.status == 'completed')
      );
      allow delete: if isAdmin();
    }

    // ===============================================================
    // DISPUTES
    // ===============================================================
    match /disputes/{disputeId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.orgId != null && resource.data.orgId == request.auth.uid) ||
        (resource.data.hostUid != null && resource.data.hostUid == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.orgId != null && resource.data.orgId == request.auth.uid) ||
        (resource.data.hostUid != null && resource.data.hostUid == request.auth.uid) ||
        isAdmin()
      );
    }

    // ===============================================================
    // APP CONFIG, GAMES, SLIDES, MEDIA & GENERAL DATA
    // ===============================================================
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /slides/{slideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promocodes/{codeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /paymentCategories/{catId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /paymentMethods/{methodId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /media/{mediaId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    match /org_posts/{postId} {
      allow read: if true;
      allow write: if isOrganizer() || isAdmin();
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /match_history/{historyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /power_org_applications/{appId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /tournamentEarnings/{earningId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        (resource.data.orgId != null && resource.data.orgId == request.auth.uid) ||
        (resource.data.hostUid != null && resource.data.hostUid == request.auth.uid)
      ));
      allow create: if isOrganizer() || isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
